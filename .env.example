# Copy to .env and adjust. All settings are optional.
PRICESCOUT_DATABASE_URL=sqlite+aiosqlite:///./data/pricescout.db
PRICESCOUT_LOG_LEVEL=INFO

# Search limits
PRICESCOUT_MAX_WEBSITES_PER_SEARCH=8
PRICESCOUT_MAX_CONCURRENT_SITES=4
PRICESCOUT_SITE_TIMEOUT_SECONDS=45
PRICESCOUT_REQUEST_TIMEOUT_SECONDS=15
PRICESCOUT_MAX_RESPONSE_BYTES=5242880
PRICESCOUT_PER_HOST_MIN_INTERVAL_SECONDS=1.0
PRICESCOUT_RESPECT_ROBOTS_TXT=true

# Playwright fallback for JavaScript-rendered sites
PRICESCOUT_PLAYWRIGHT_ENABLED=true
PRICESCOUT_PLAYWRIGHT_MAX_CONCURRENCY=2

# Product matching: minimum relevance (0-1) for a listing to count as a match
PRICESCOUT_MATCH_THRESHOLD=0.6

# Currency conversion. Without rates, prices in different currencies are
# shown side by side but never ranked against each other.
PRICESCOUT_COMPARISON_CURRENCY=USD
# Option A: static rates = units of each currency per 1 comparison currency
# PRICESCOUT_EXCHANGE_RATES={"USD": 1, "KES": 129.2, "EUR": 0.92, "GBP": 0.79}
# PRICESCOUT_EXCHANGE_RATES_AS_OF=2026-11-01T00:00:00Z
# Option B: a provider returning {"rates": {...}} for base {base}
# PRICESCOUT_EXCHANGE_RATE_PROVIDER_URL=https://open.er-api.com/v6/latest/{base}

# Optional official eBay Browse API (used instead of HTML scraping when set)
# PRICESCOUT_EBAY_CLIENT_ID=
# PRICESCOUT_EBAY_CLIENT_SECRET=
# PRICESCOUT_EBAY_MARKETPLACE_ID=EBAY_US
